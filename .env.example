# fastmatch.com.au — environment template. Copy to .env and fill in.
# Complete list of variables the code reads (src/ process.env.* + schema.prisma).

# REQUIRED — MySQL connection string.
DATABASE_URL="mysql://user:password@127.0.0.1:3306/fastmatch_dev"

# REQUIRED — session signing. Logins and emailed links fail if unset (it's
# read when first needed, so a build without it still works).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# REQUIRED — base URL used in verification / reset / check-in links.
APP_URL="http://localhost:3000"

# REQUIRED in production — where uploaded images are kept. It must be a folder
# OUTSIDE the release folders, or the images are lost on the next deploy
# (src/lib/uploads.ts). Blank: <project>/uploads, for local development.
# Production: UPLOAD_DIR="/var/www/fastmatch.com.au/shared/uploads"
UPLOAD_DIR=""

# Optional — the time zone the reports and the nightly results job count days
# in. Blank: Australia/Sydney.
EVENT_TIME_ZONE=""

# Admin bootstrap for prisma/seed.ts — creates/promotes this account to admin.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# Optional — the admin's name ("FastMatch Admin" when not set).
# SEED_ADMIN_NAME="FastMatch Admin"

# Needed for booking + payment routes only.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email — Mailgun over SMTP (nodemailer).
# If MAILGUN_SMTP_USER or MAILGUN_SMTP_PASS is unset, email falls back to a
# console.log stub — nothing is sent and nothing errors.
MAILGUN_SMTP_HOST="smtp.mailgun.org"
MAILGUN_SMTP_PORT="587"
MAILGUN_SMTP_USER=""
MAILGUN_SMTP_PASS=""
# Must be a Mailgun-verified sending domain, or Mailgun rejects the message.
EMAIL_FROM_ADDRESS="FastMatch <no-reply@mg.fastmatch.live>"
# Mailgun > Sending > Webhooks > "HTTP webhook signing key". Bounce reports
# (point "Permanent Failure" at /api/webhooks/email-bounce) are only accepted
# when signed with it; while unset, every report is refused.
MAILGUN_WEBHOOK_SIGNING_KEY=""

# SMS — Cellcast.
# If CELLCAST_API_KEY is unset, SMS falls back to a console.log stub — nothing
# is sent and nothing errors.
CELLCAST_API_KEY=""
# Optional — both have working defaults.
# Alphanumeric, max 11 chars. Blank makes Cellcast use its shared number.
CELLCAST_SENDER_ID="FastMatch"
CELLCAST_API_URL="https://api.cellcast.com/api/v1/gateway"
CELLCAST_ACCOUNT_URL="https://api.cellcast.com/api/v1/apiClient/account"
