// fastmatch.com.au — Prisma schema
// Matches fastmatch-com-au-spec.md. MySQL, following the same stack as FastmatchLive.

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Gender {
  MALE
  FEMALE
}

enum EventVisibility {
  PUBLIC
  NOT_PUBLIC
}

enum EventStatus {
  UPCOMING
  CLOSED
  CANCELLED
}

enum Choice {
  NO
  FRIEND
  DATE
}

enum MatchResult {
  FRIEND
  DATE
}

enum DiscountType {
  PERCENT_OFF
  FIXED_REDUCTION
  FREE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

// How an admin-added booking was paid — the "Payment Status" select on the
// admin Add booking / Add member screens. NULL means the member booked and
// paid online through Stripe themselves (and covers every booking made
// before this column existed).
enum PaymentMethod {
  CASH
  CARD
  PAY_AT_DOOR
  FRIEND_BOOKED_IN
}

model Member {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  emailVerified  Boolean   @default(false)
  mobileVerified Boolean   @default(false)
  mobileVerificationCode    String?
  mobileVerificationExpires DateTime?
  name           String
  gender         Gender
  dateOfBirth    DateTime
  mobile         String
  city           City      @relation(fields: [cityId], references: [id])
  cityId         String
  agreedTerms    Boolean   @default(false)
  agreedTermsAt  DateTime?
  marketingOptIn Boolean   @default(true)
  contactMethod  ContactMethod @default(EMAIL_AND_SMS)
  emailBounced   Boolean   @default(false)
  bounceReason   String?
  isAdmin        Boolean   @default(false)
  // True for an account made for a friend someone else booked in: they never
  // chose a password. Their booking email carries a one-time "set your
  // password" link; using it clears this. See /set-password.
  awaitingPasswordSetup Boolean @default(false)
  // The member who invited them through "Tell A Friend". Their date of birth
  // is then only worked out from an age the inviter typed, so /set-password
  // asks them for the real one.
  referredBy     Member?   @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referredById   String?
  referrals      Member[]  @relation("Referrals")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  bookings       Booking[]
  feedback       Feedback[]
  ratingsGiven   Rating[]  @relation("RatingsGiven")
  ratingsReceived Rating[] @relation("RatingsReceived")
  matchesAsA     Match[]   @relation("MatchAsMemberA")
  matchesAsB     Match[]   @relation("MatchAsMemberB")

  // Never store raw card data — Stripe customer/payment method references only
  stripeCustomerId String?
}

model City {
  id     String  @id @default(cuid())
  name   String  @unique
  events Event[]
  members Member[]
  venues Venue[]
}

// Venue directory — replaces the free-text `Event.venue` string, so the same
// place is described once and reused. Selecting a venue on a blast copies its
// details into that blast (see renderCampaignEmailHtml / the blast form);
// blasts deliberately do NOT hold a reference back here, so editing a venue
// can't rewrite a blast that was already written and proofread.
//
// Belongs to a City: the event form filters the venue dropdown by the city
// already chosen on the event, which mirrors the old system's venue->location
// relationship and stops a Sydney venue being attached to a Melbourne event.
model Venue {
  id         String   @id @default(cuid())
  name       String
  address    String?
  phone      String?
  websiteUrl String?
  // Logo, image and description are the venue's own. Picking a venue on the
  // event or blast forms COPIES the image and description into that event's
  // or blast's own fields (Event.photoUrl / description, Campaign.photoUrl /
  // eventDetailsText), where they can be changed for that one event —
  // editing the venue later doesn't rewrite them. Uploaded through the same
  // sharp pipeline as other photos (src/lib/uploads.ts); these hold URLs.
  logoUrl     String?
  imageUrl    String?
  description String?  @db.Text
  city       City     @relation(fields: [cityId], references: [id])
  cityId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  events Event[]

  // Same venue name can exist in two cities ("Grand Hotel", Sydney and Perth)
  // but not twice within one.
  @@unique([name, cityId])
  @@index([cityId])
}

model EventTheme {
  id     String  @id @default(cuid())
  name   String  @unique
  active Boolean @default(true)
  events Event[]
}

model EventSeries {
  id        String   @id @default(cuid())
  frequency String   // DAILY | WEEKLY | MONTHLY
  interval  Int      @default(1)
  createdAt DateTime @default(now())
  events    Event[]
}

model Event {
  id            String          @id @default(cuid())
  number        Int             @unique @default(autoincrement())
  name          String          // e.g. "Ages 28-40, Sydney CBD"
  // Longer blurb shown to members on the public event page, under the Book
  // button. Distinct from `name`, which is the short label used in lists,
  // emails and SMS. Optional — existing events have none.
  description   String?         @db.Text
  // Shown at the top of the public event page, above the details. Uploaded
  // through the same sharp re-encode pipeline as blast photos and stored in
  // UPLOAD_DIR (see src/lib/uploads.ts); this holds the served URL. Moved
  // here from Venue — see the note on that model.
  photoUrl      String?
  theme         EventTheme      @relation(fields: [themeId], references: [id])
  themeId       String
  city          City            @relation(fields: [cityId], references: [id])
  cityId        String
  // Was a free-text String until the venue directory was added. Events are
  // now always attached to a Venue row — the admin picks from the dropdown,
  // adding the venue first if it's somewhere new.
  venue         Venue           @relation(fields: [venueId], references: [id])
  venueId       String
  startsAt      DateTime
  ageMin        Int
  ageMax        Int
  maxMen        Int             @default(12)
  maxWomen      Int             @default(12)
  cost          Decimal         @db.Decimal(10, 2)
  expenses      Decimal?        @db.Decimal(10, 2)
  visibility    EventVisibility @default(PUBLIC)
  status        EventStatus     @default(UPCOMING)
  // Ticked by the admin on the event form once the venue is locked in and
  // enough people are coming. Purely the admin's own call — nothing in the
  // app sets it. Drives the yellow/orange split on /admin/events for events
  // in the next seven days.
  confirmed     Boolean         @default(false)
  // Set on a copy made by "Duplicate event": hidden from the public site and
  // unbookable until the admin opens the copy and saves it. Saving the edit
  // form clears it.
  draft         Boolean         @default(false)
  // "FastMatch Discounts": when off, the discount-code box is hidden on the
  // event page and the booking API refuses codes for this event.
  fastmatchDiscounts Boolean    @default(true)
  // "Group Discounts": when on, a member booking this event can bring
  // friends, paying for them and getting GROUP_DISCOUNT_PER_FRIEND off per
  // friend (see src/lib/bookingPrice.ts).
  groupDiscounts     Boolean    @default(true)
  series        EventSeries?    @relation(fields: [seriesId], references: [id])
  seriesId      String?

  matchesCalculated Boolean @default(false)
  matchesCalculatedAt DateTime?
  matchEmailsSent   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]
  ratings  Rating[]
  matches  Match[]
  feedback Feedback[]
  excludedFromCampaigns Campaign[] @relation("CampaignExcludeBooked")

  @@index([startsAt])
  @@index([themeId])
  @@index([cityId])
  @@index([venueId])
}

model Booking {
  id             String        @id @default(cuid())
  event          Event         @relation(fields: [eventId], references: [id])
  eventId        String
  member         Member        @relation(fields: [memberId], references: [id])
  memberId       String
  badge          Int           // the number assigned for the night, sequential per event
  status         BookingStatus @default(PENDING)
  paidAmount     Decimal       @db.Decimal(10, 2)
  discountCode   DiscountCode? @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  discountCodeId String?
  stripePaymentIntentId String?
  paymentMethod  PaymentMethod?
  // A friend's booking points at the booking of the member who brought and
  // paid for them. Confirmed together when that member's payment succeeds.
  bookedBy       Booking?      @relation("FriendBookings", fields: [bookedById], references: [id], onDelete: SetNull)
  bookedById     String?
  friendBookings Booking[]     @relation("FriendBookings")
  // Friends on a booking still waiting for payment: their details and the
  // amount paid for each. Nothing is created for them — no account, no
  // booking, no email — until the payment succeeds (confirmBookingGroup),
  // because an unpaid booking holds no places. Cleared once they're created.
  pendingFriends Json?
  checkedIn      Boolean       @default(false)
  checkedInAt    DateTime?
  reminderSent   Boolean       @default(false)
  // When it was first confirmed (paid). Confirming it again after it was set
  // back to unpaid doesn't re-send the emails or count its discount code twice.
  confirmedAt    DateTime?
  // A cancelled or refunded booking the member reopened by booking again:
  // what it was, so it's put back if the new payment never arrives.
  reopenedFrom   Json?
  createdAt      DateTime      @default(now())

  @@unique([eventId, memberId])
  @@unique([eventId, badge])
}

// One row per rating a person gives another attendee at an event — replaces the old
// comma-separated dateList/friendsList text fields with proper relational rows.
model Rating {
  id           String   @id @default(cuid())
  event        Event    @relation(fields: [eventId], references: [id])
  eventId      String
  rater        Member   @relation("RatingsGiven", fields: [raterId], references: [id])
  raterId      String
  ratedMember  Member   @relation("RatingsReceived", fields: [ratedMemberId], references: [id])
  ratedMemberId String
  choice       Choice
  createdAt    DateTime @default(now())

  @@unique([eventId, raterId, ratedMemberId])
}

// One row per mutual match, computed when the event closes (midnight auto or host override).
model Match {
  id         String      @id @default(cuid())
  event      Event       @relation(fields: [eventId], references: [id])
  eventId    String
  memberA    Member      @relation("MatchAsMemberA", fields: [memberAId], references: [id])
  memberAId  String
  memberB    Member      @relation("MatchAsMemberB", fields: [memberBId], references: [id])
  memberBId  String
  result     MatchResult
  emailSent  Boolean     @default(false)
  createdAt  DateTime    @default(now())

  @@unique([eventId, memberAId, memberBId])
}

model DiscountCode {
  id          String       @id @default(cuid())
  code        String       @unique
  type        DiscountType
  amount      Decimal?     @db.Decimal(10, 2) // percent or fixed $ depending on type
  scopeThemeId String?     // null = applies to all events
  // "Event" on the discount code form: null = "All" events (the default);
  // otherwise the code only works when booking that one event. A plain id
  // like scopeThemeId, not a relation: if the event is ever deleted the code
  // matches no event, rather than falling back to working on every event.
  scopeEventId String?
  validFrom   DateTime
  validTo     DateTime
  usedCount   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  bookings Booking[]
}

enum ContactMethod {
  EMAIL_AND_SMS
  EMAIL
  SMS
  DO_NOT_CONTACT
}

enum CampaignSendStatus {
  PENDING
  SENDING
  PAUSED
  SENT
  CANCELLED
}

// Reusable templates for the "Blast Template" dropdown on Create Blast.
model CampaignTemplate {
  id        String   @id @default(cuid())
  title     String
  subject   String?
  // Structured fields (preferred path — renders into the branded layout via
  // renderCampaignEmailHtml) and emailBody (a raw-HTML override, for anyone
  // who wants to bypass the structured fields entirely) can both be set;
  // emailBody wins if present. Matches FastmatchLive's template model.
  heading          String?
  freeText         String? @db.Text // multi-paragraph body copy
  eventDetailsText String? @db.Text // free-form (When/Where/Cost/Age etc, admin's own wording)
  bookingLink      String?
  photoUrl         String?
  bannerImageUrl   String? // optional full-width custom header banner, replacing the default plain banner — e.g. a themed frame. The uploaded image must carry any needed branding/text itself, since text-over-image CSS overlays aren't reliable across email clients.
  emailBody String?  @db.Text
  smsBody   String?  @db.Text
  createdAt DateTime @default(now())

  campaigns Campaign[]
}

// A Blast is a REUSABLE definition — matches the real system exactly:
// content/filter can be sent multiple times (each a separate CampaignSend),
// not a one-shot draft-then-sent record. "Unused" means it has zero sends.
model Campaign {
  id       String  @id @default(cuid())
  title    String
  template CampaignTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateId String?

  automated        Boolean @default(false) // sends automatically to unconfirmed members
  ignorePreference Boolean @default(false) // overrides marketingOptIn/contactMethod when true
  // "Exclude booked members": skip anyone with a paid booking — for one event
  // (excludeBookedEventId), or for any upcoming event when that's null — so a
  // "book now" blast doesn't go to people already coming.
  excludeBooked        Boolean @default(false)
  excludeBookedEvent   Event?  @relation("CampaignExcludeBooked", fields: [excludeBookedEventId], references: [id], onDelete: SetNull)
  excludeBookedEventId String?
  reusable         Boolean @default(true)  // "Stop re-using blast" sets this false

  sendEmail     Boolean @default(true)
  fromName      String  @default("FastMatch")
  fromEmail     String  @default("donotreply@fastmatch.com.au")
  subject       String?
  // Structured fields — selecting a template on Create Blast COPIES these
  // into this specific blast's own row, not a reference back to the shared
  // template. So the photo (or any other field) can be swapped for this one
  // blast without touching the template or any other blast built from it —
  // the original problem this was built to solve was photos going stale
  // when every blast shared one rendered copy. emailBody is a raw-HTML
  // override for anyone who wants to bypass structured rendering entirely;
  // if set, it wins — see resolveCampaignEmailHtml in campaignEmail.ts.
  heading          String?
  freeText         String? @db.Text
  eventDetailsText String? @db.Text
  bookingLink      String?
  photoUrl         String?
  bannerImageUrl   String?
  // The venue's logo, copied in by "Fill from a venue"; shown under the
  // event details in the email.
  venueLogoUrl     String?
  emailBody     String? @db.Text

  sendSms       Boolean @default(false)
  smsFromNumber String?
  smsBody       String? @db.Text

  // The "working" filter shown on the Send tab — can be adjusted before each
  // send; every actual send snapshots it into CampaignSend.filterSnapshot so
  // history shows exactly what was used for that particular send.
  filter Json

  testSentAt DateTime?
  testSentTo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sends CampaignSend[]
}

// One row per actual send of a Campaign — this is what the "History" tab
// lists, and what the play/pause/cancel controls on Current Blasts operate on.
model CampaignSend {
  id              String             @id @default(cuid())
  campaign        Campaign           @relation(fields: [campaignId], references: [id])
  campaignId      String
  filterSnapshot  Json               // the filter as it was at the moment this send started
  status          CampaignSendStatus @default(PENDING)
  totalRecipients Int                @default(0)
  sentCount       Int                @default(0)
  // Recipients a message failed for (an email or text that didn't go), so
  // the progress box and History can say "N sent, M failed".
  failedCount     Int                @default(0)
  recipientIds    Json?              // locked in once sending starts — pause/resume continue against this exact list
  startedAt       DateTime           @default(now())
  completedAt     DateTime?
}

// "Member Feedback" — what members send from the Feedback page. Emailed to
// Gil as it arrives and kept here so the admin can look back through it on
// /admin/feedback (as on the old admin). eventId is null for a general
// comment. A deleted event leaves its feedback behind as general comments.
model Feedback {
  id        String   @id @default(cuid())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  String
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventId   String?
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Attempt counters for rate limiting: failed logins, mobile code guesses,
// code resends, password resets, Contact Us and Tell A Friend. One row per
// key (a hashed IP, email or member id with a prefix, never the raw value);
// the count starts again once resetAt passes. See src/lib/rateLimit.ts.
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

// A sign-up waiting for its email link to be clicked (src/lib/pendingSignup.ts).
// The account itself is only created from the link, so the sign-up form gives
// the same answer whether or not the address already belongs to a member.
model PendingSignup {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  email     String
  data      Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}
