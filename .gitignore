node_modules/
.next/
out/
build/

# TypeScript incremental-build cache. Regenerated by every `tsc` run and by
# `next dev`, so tracking it makes git status noisy and every audit harder.
*.tsbuildinfo
tsconfig.tsbuildinfo

.env
.env.local
.env*.local

*.log
npm-debug.log*

.DS_Store
next-env.d.ts

# Runtime-uploaded blast images. In production UPLOAD_DIR points outside
# the release directory (see src/lib/uploads.ts); this covers the local
# development fallback.
/uploads

# Member lists and import reports (names, emails, mobiles, dates of birth)
# must never reach git, wherever they are saved: the import writes
# <file>.skipped.csv beside its input, and members-import/data/ is only one
# of the places a CSV can end up. No CSV is tracked on purpose.
*.csv
*.skipped.csv
